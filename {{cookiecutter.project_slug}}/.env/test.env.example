DJANGO_SETTINGS_MODULE=config.settings.test_settings
DJANGO_SECRET_KEY=__SECRET__
JWT_SECRET_KEY=__SECRET__
ALLOWED_HOSTS=test.example.com
DEBUG=0
TZ={{ cookiecutter.timezone }}

# Space-separated list. Used for CSRF trusted origins (and CORS outside dev).
ALLOWED_ORIGINS=https://test.example.com

# dj-database-url format: postgres://USER:PASSWORD@HOST:PORT/NAME
DB_CONNECTION=postgres://{{ cookiecutter.db_name }}:__DB_PASSWORD__@db:5432/{{ cookiecutter.db_name }}

# Postgres container credentials
POSTGRES_DB={{ cookiecutter.db_name }}
POSTGRES_USER={{ cookiecutter.db_name }}
POSTGRES_PASSWORD=__DB_PASSWORD__
{% if cookiecutter.__redis == "y" %}
# Redis
REDIS_PWD=__REDIS_PASSWORD__
REDIS_CONNECTION=redis://:__REDIS_PASSWORD__@redis:6379/0
{% endif %}{% if cookiecutter.use_celery == "y" %}
# Celery
CELERY_BROKER=redis://:__REDIS_PASSWORD__@redis:6379/1
CELERY_BACKEND=redis://:__REDIS_PASSWORD__@redis:6379/2

# Database backup (scripts/postgres-backup.sh)
PGHOST=db
PGUSER={{ cookiecutter.db_name }}
PGPASSWORD=__DB_PASSWORD__
PGDATABASE={{ cookiecutter.db_name }}
RETENTION_DAYS=3
{% endif %}{% if cookiecutter.use_sentry == "y" %}
# Sentry (production / test)
SENTRY_DSN=
{% endif %}{% if cookiecutter.use_s3 == "y" %}
# S3 presigned uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_PROJECT_PREFIX={{ cookiecutter.project_slug }}
AWS_S3_UPLOAD_MAX_BYTES=10485760
{% endif %}
